# Jeton partagé entre Open WebUI et le studio (secret Kubernetes « studio », clé « jeton »).
# Reprenez celui des modules précédents, ou générez-en un : openssl rand -hex 24
STUDIO_JETON=
# Mot de passe de Redis (secret Kubernetes « studio », clé « redis »), repris du module 2.
REDIS_MOT_DE_PASSE=
# La version de la bibliothèque ne se règle pas ici : « reference: studio3d-assets:<version> »
# dans k8s-echelle.yaml (écrite par assets/importer.mjs --deployer).
# La politique de marquage visible ne se règle pas ici : voir MARQUAGE_VISIBLE_DEFAUT et
# MARQUAGE_VISIBLE_IMPOSE dans k8s-echelle.yaml (valeurs « oui » ou « non »).
