# Token shared by Open WebUI and the studio (Kubernetes secret "studio", key "token").
# Reuse the one from the previous modules, or generate one: openssl rand -hex 24
STUDIO_TOKEN=
# Redis password (Kubernetes secret "studio", key "redis"), reused from module 2.
REDIS_PASSWORD=
# The library version is not set here: "reference: studio3d-assets:<version>"
# in k8s-scale.yaml (written by assets/importer.mjs --deploy).
# The visible marking policy is not set here: see MARKING_VISIBLE_DEFAULT and
# MARKING_VISIBLE_ENFORCED in k8s-scale.yaml (values "yes" or "no").
